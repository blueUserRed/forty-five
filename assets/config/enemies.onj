],

var action = {
    pyro: {
        hotPotato: $GivePlayerCard {
            card: "scorchingBullet"#card,
            icon: "enemy_action_hot_potato",
            hasSpecialAnimation: true,
            commonPanel1: "enemy_pyro_action_comic_common_panel_1",
            commonPanel2: "enemy_pyro_action_comic_common_panel_2",
            commonPanel3: "enemy_pyro_action_comic_common_panel_3",
            specialPanel: "enemy_pyro_action_comic_panel_hot_potato",
            title: "Hot Potato",
            descriptionTemplate: "A Scorching Bullet will be put in your hand!",
        },
        burning3to5: $GivePlayerStatusEffect {
            statusEffect: burningPlayer([3, 5]#val, 0.5, false),
            icon: "enemy_action_burning",
            hasSpecialAnimation: true,
            commonPanel1: "enemy_pyro_action_comic_common_panel_1",
            commonPanel2: "enemy_pyro_action_comic_common_panel_2",
            commonPanel3: "enemy_pyro_action_comic_common_panel_3",
            specialPanel: "enemy_pyro_action_comic_panel_burning",
            title: "Burning",
            descriptionTemplate: "You get Burning!",
        },
        burning4to6: $GivePlayerStatusEffect {
            statusEffect: burningPlayer([4, 6]#val, 0.5, false),
            icon: "enemy_action_burning",
            hasSpecialAnimation: true,
            commonPanel1: "enemy_pyro_action_comic_common_panel_1",
            commonPanel2: "enemy_pyro_action_comic_common_panel_2",
            commonPanel3: "enemy_pyro_action_comic_common_panel_3",
            specialPanel: "enemy_pyro_action_comic_panel_burning",
            title: "Burning",
            descriptionTemplate: "You get Burning!",
        },
        burning6to8: $GivePlayerStatusEffect {
            statusEffect: burningPlayer([6, 8]#val, 0.5, false),
            icon: "enemy_action_burning",
            hasSpecialAnimation: true,
            commonPanel1: "enemy_pyro_action_comic_common_panel_1",
            commonPanel2: "enemy_pyro_action_comic_common_panel_2",
            commonPanel3: "enemy_pyro_action_comic_common_panel_3",
            specialPanel: "enemy_pyro_action_comic_panel_burning",
            title: "Burning",
            descriptionTemplate: "You get Burning!",
        }
    },
    witch: {
        rotateRevolver: $RotateRevolver {
            maxTurns: 1,
            forceDirection: "left",
            icon: "enemy_action_left_turn",
            hasSpecialAnimation: true,
            commonPanel1: "enemy_witch_action_comic_common_panel_1",
            commonPanel2: "enemy_witch_action_comic_common_panel_2",
            commonPanel3: "enemy_witch_action_comic_common_panel_3",
            specialPanel: "enemy_witch_action_comic_panel_left_turn",
            title: "Left Turn",
            descriptionTemplate: "The revolver rotates to the left!",
        },
        bewitched1: $GivePlayerStatusEffect {
            statusEffect: bewitched([1, 2]#val, [4, 6]#val),
            icon: "enemy_action_bewitched",
            hasSpecialAnimation: true,
            commonPanel1: "enemy_witch_action_comic_common_panel_1",
            commonPanel2: "enemy_witch_action_comic_common_panel_2",
            commonPanel3: "enemy_witch_action_comic_common_panel_3",
            specialPanel: "enemy_witch_action_comic_panel_bewitched",
            title: "Bewitched",
            descriptionTemplate: "You get the Bewitched status effect!",
        },
        bewitched2: $GivePlayerStatusEffect {
            statusEffect: bewitched([2, 3]#val, [6, 8]#val),
            icon: "enemy_action_bewitched",
            hasSpecialAnimation: true,
            commonPanel1: "enemy_witch_action_comic_common_panel_1",
            commonPanel2: "enemy_witch_action_comic_common_panel_2",
            commonPanel3: "enemy_witch_action_comic_common_panel_3",
            specialPanel: "enemy_witch_action_comic_panel_bewitched",
            title: "Bewitched",
            descriptionTemplate: "You get the Bewitched status effect!",
        }
    }
};

