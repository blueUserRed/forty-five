var pyros = [
    {
        name: "Pyro-1",
        title: "Pyro",
        baseHealth: 75,
        texture: "enemy_pyro",
        brain: $NewEnemyBrain {
            normalSpecialActionWeight: 0.0,
//            normalSpecialActionWeight: 0.78,
            damageShieldWeight: 0.78,
            baseDamage: [3, 5],
            baseShield: [3, 5],
            aggressionBoostConfig: {
                healthPercent: 0.1,
                normalSpecialWeightChange: 1.0,
                damageShieldWeightChange: 1.0,
                damageIncrease: 3,
            },
            scaleIncreasePerTurn: 0.0,
            actions: [
                // pyro level one only does burning, not hot potato
                {
                    weight: 20,
                    showProbability: 1.0, // always shown
                    action: action.pyro.burning3to5
                },
            ],
        },
    },
    {
        name: "Pyro-2",
        title: "Pyro",
        baseHealth: 110,
        texture: "enemy_pyro",
        brain: $NewEnemyBrain {
            normalSpecialActionWeight: 0.7,
            damageShieldWeight: 0.78,
            baseDamage: [8, 10],
            baseShield: [8, 12],
            aggressionBoostConfig: {
                healthPercent: 0.1,
                normalSpecialWeightChange: 1.0,
                damageShieldWeightChange: 1.0,
                damageIncrease: 4,
            },
            scaleIncreasePerTurn: 0.0,
            actions: [
                {
                    // hot potato, but always shown and unlikely
                    weight: 5,
                    showProbability: 1.0,
                    maxExecutions: 1,
                    action: action.pyro.hotPotato
                },
                {
                    weight: 20,
                    showProbability: 0.8, // burning can now be hidden
                    action:action.pyro.burning4to6
                },
            ],
        },
    },
    {
        name: "Pyro-3",
        title: "Pyro",
        baseHealth: 130,
        texture: "enemy_pyro",
        brain: $NewEnemyBrain {
            normalSpecialActionWeight: 0.7,
            damageShieldWeight: 0.78,
            baseDamage: [9, 12],
            baseShield: [10, 15],
            aggressionBoostConfig: {
                healthPercent: 0.1,
                normalSpecialWeightChange: 1.0,
                damageShieldWeightChange: 1.0,
                damageIncrease: 5,
            },
            scaleIncreasePerTurn: 0.0,
            actions: [
                {
                    // hot potato is now more likely and can be hidden
                    weight: 13,
                    showProbability: 0.8,
                    maxExecutions: 1,
                    action: action.pyro.hotPotato
                },
                {
                    weight: 20,
                    showProbability: 0.6,
                    action:action.pyro.burning6to8
                },
            ],
        },
    },
    {
        name: "Pyro-4",
        title: "Pyro",
        baseHealth: 160,
        texture: "enemy_pyro",
        brain: $NewEnemyBrain {
            normalSpecialActionWeight: 0.6, // 40% chance of doing special action
            damageShieldWeight: 0.78,
            baseDamage: [9, 12],
            baseShield: [10, 15],
            aggressionBoostConfig: {
                healthPercent: 0.1,
                normalSpecialWeightChange: 1.0,
                damageShieldWeightChange: 1.0,
                damageIncrease: 6,
            },
            scaleIncreasePerTurn: 0.0,
            actions: [
                {
                    weight: 20, // very likely
                    showProbability: 0.8,
                    maxExecutions: 2, // evil
                    action: action.pyro.hotPotato
                },
                {
                    weight: 20,
                    showProbability: 0.6,
                    action:action.pyro.burning6to8
                },
            ],
        },
    },
];

