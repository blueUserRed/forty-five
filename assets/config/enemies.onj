var pyros = [
    {
        name: "Pyro-1",
        title: "Pyro",
        baseHealth: 130,
        texture: "enemy_pyro",
        actions: [
            {
                weight: 22#actionVal,
                action: action_damage(5, 10, false)
            },
            {
                weight: 4#actionVal,
                action: action_parryableBurning(3, 7),
                overrideTitle: "Pyro-dmg"
            },
            {
                weight: 4#actionVal,
                action: action_passiveEffect(heatRepellent()),
                overrideTitle: "Heat Repellent",
                overrideDescription: "The enemy gives itself $status$HEAT REPELLENT$status$ for the remainder of the encounter",
                maxExecutions: 1
            },
            {
                weight: 8#actionVal,
                action: action_givePlayerStatus(burningPlayer(3#val, 0.5, false)),
                overrideTitle: "You get Burning!",
            }
        ]
    },
    {
        name: "Pyro-2",
        title: "Pyro",
        baseHealth: 160,
        texture: "enemy_pyro",
        actions: [
            {
                weight: 22#actionVal,
                action: action_damage(8, 12, false)
            },
            {
                weight: 4#actionVal,
                selectionConditions: [
                    value.countPlayerStatusEffectParams#actionVal moreThan 3#actionVal
                ],
                action: action_variableDamage(
                    value.countPlayerStatusEffectParams#actionVal,
                    false,
                    "The damage of this attack is equal to the sum of all the parameters of the Status Effects you have"
                )
            },
            {
                weight: 4#actionVal,
                action: action_parryableBurning(5, 8),
                overrideTitle: "Pyro-dmg"
            },
            {
                weight: 4#actionVal,
                action: action_givePlayerCard("scorchingBullet"#card),
                overrideTitle: "Hot Potato",
                maxExecutions: 2
            },
            {
                weight: 4#actionVal,
                action: action_passiveEffect(heatRepellent()),
                overrideTitle: "Heat Repellent",
                overrideDescription: "The enemy gives itself $status$HEAT REPELLENT$status$ for the remainder of the encounter",
                maxExecutions: 1
            },
            {
                weight: 8#actionVal,
                action: action_givePlayerStatus(burningPlayer(4#val, 0.5, false)),
                overrideTitle: "You get Burning!",
            }
        ]
    }
];

