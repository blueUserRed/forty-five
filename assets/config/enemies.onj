var outlaws = [
    {
        name: "Outlaw-1",
        title: "Outlaw",
        texture: "enemy_outlaw",
        baseHealth: 100,
        actions: [
            {
                weight: 10#actionVal,
                action: action_damage(6, 10, false)
            },
            {
                weight: 5#actionVal,
                action: action_damage(6, 10, true)
            },
            {
                weight: 7#actionVal,
                action: action_shield(8, 11)
            },
            {
                weight: largeNumber#actionVal,
                selectionConditions: [
                    curEnemyHealth() lessThan enemyBaseHealthPercent(35.0)
                ],
                maxExecutions: 1,
                action: action_damage(15, 20, false)
            },
        ]
    }
];

var pyros = [
    {
        name: "Pyro-1",
        title: "Pyro",
        baseHealth: 160,
        texture: "enemy_pyro",
        actions: [
            {
                weight: 10#actionVal,
                action: action_damage(5, 10, false)
            },
            {
                weight: 4#actionVal,
                selectionConditions: [
                    value.countPlayerStatusEffectParams#actionVal moreThan 3#actionVal
                ],
                action: action_variableDamage(
                    value.countPlayerStatusEffectParams#actionVal,
                    false,
                    "The damage of this attack is equal to the sum of all the parameters of the Status Effects you have"
                )
            },
            {
                weight: 4#actionVal,
                action: action_parryableBurning(3, 7),
                overrideTitle: "Pyro-dmg"
            },
        ]
    }
];

enemies: [

    {
        name: "Outlaw_test",
        title: "Outlaw",
        baseHealth: 50,
        texture: "enemy_outlaw",
        actions: []
    },

    ...outlaws,
    ...pyros

