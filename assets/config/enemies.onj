///schema=onjschemas/enemies.onjschema
import "imports/colors.onj" as color;

use Cards;

enemyGroups: [
    {
        groupName: "Outlaw",
        variants: [
            {
                name: "Outlaw-1",
                majorDifficulty: 1
            },
            {
                name: "Outlaw-2",
                majorDifficulty: 2
            },
            {
                name: "Outlaw-3",
                majorDifficulty: 3
            },
            {
                name: "Outlaw-4",
                majorDifficulty: 4
            },
        ]
    },
    {
        groupName: "Pyro",
        variants: [
            {
                name: "Pyro-1",
                majorDifficulty: 1
            },
            {
                name: "Pyro-2",
                majorDifficulty: 2
            },
            {
                name: "Pyro-3",
                majorDifficulty: 3
            },
            {
                name: "Pyro-4",
                majorDifficulty: 4
            },
        ]
    },
    {
        groupName: "Witch",
        variants: [
            {
                name: "Witch-1",
                majorDifficulty: 1
            },
            {
                name: "Witch-2",
                majorDifficulty: 2
            },
            {
