///schema=onjschemas/run_generator_config.onjschema

//////////////////////////////////////////////////////
// Run Modifiers
//////////////////////////////////////////////////////

runModifierPools: [
    {
        majorDifficulty: 0,
        modifierProbability: 0.0,
        maxModifiers: 0,
        modifiers: []
    },
    {
        majorDifficulty: 2,
        modifierProbability: 0.4,
        maxModifiers: 1,
        modifiers: [ "AllRain", "AllMoist" ]
    },
    {
        majorDifficulty: 4,
        modifierProbability: 0.3,
        maxModifiers: 1,
        onlyConstructed: true,
        modifiers: [ "AllRain", "AllMoist", "AllBewitchedMist" ]
    },
    {
        majorDifficulty: 5,
        modifierProbability: 0.4,
        maxModifiers: 2,
        onlyConstructed: true,
        modifiers: [ "AllBewitchedMist", "AllFrozen", "AllMoist" ]
    },
    {
        majorDifficulty: 3,
        modifierProbability: 0.5,
        maxModifiers: 1,
        onlyLimited: true,
        modifiers: [ "AllRain", "AllMoist", "AllBewitchedMist" ]
    },
    {
        majorDifficulty: 4,
        modifierProbability: 0.5,
        maxModifiers: 2,
        onlyLimited: true,
        modifiers: [ "AllBewitchedMist", "AllFrozen", "AllMoist" ]
    },
],

runModifierProbabilityIncreases: [
    {
        biome: "bewitched_forest",
        makeMoreLikely: ["AllBewitchedMist"],
    }
],

runModifierBlacklist: [
    [ "allMoist", "allFrozen" ],
    [ "allFrozen", "allBewitchedMist" ],
],

//////////////////////////////////////////////////////
// Run rewards
//////////////////////////////////////////////////////


runRewardPools: [
    {
        majorDifficulty: 0,
        maxRewards: 1,
        rewardProbability: 1.0,
        rewards: [
            [
                $CashReward {
                    amount: 200
                },
                $CashReward {
                    amount: 250
                },
                $CashReward {
                    amount: 300
                },
            ]
        ]
    },
    {
        majorDifficulty: 2,
        maxRewards: 1,
        rewardProbability: 1.0,
        rewards: [
            [
                $CashReward {
                    amount: 300
                },
                $CashReward {
                    amount: 350
                },
                $CashReward {
                    amount: 400
                },
            ]
        ]
    }
],


//////////////////////////////////////////////////////
// Encounter modifier
//////////////////////////////////////////////////////


encounterModifierPools: [
    {
        majorDifficulty: 0,
        modifierProbability: 0.0,
        maxModifiers: 0,
        modifiers: []
    },
    {
        majorDifficulty: 2,
        modifierProbability: 0.3,
        maxModifiers: 1,
        modifiers: [ "rain", "moist", "bewitchedMist" ]
    },
    {
        majorDifficulty: 3,
        modifierProbability: 0.5,
        maxModifiers: 2,
        modifiers: [ "rain", "moist", "bewitchedMist", "frost", "steelnerves" ]
    },
    {
        majorDifficulty: 5,
        modifierProbability: 0.7,
        maxModifiers: 3,
        modifiers: [ "rain", "moist", "bewitchedMist", "frost", "steelnerves" ]
    },
],

encounterModifierBlacklist: [
    [ "frost", "moist" ],
    [ "frost", "bewitchedMist"],
],

//////////////////////////////////////////////////////
// Steps
//////////////////////////////////////////////////////

stepConfig: {
    limited: {
        minSteps: [5, 10],
        maxSteps: [15, 25],
    },
    constructed: {
        minSteps: [5, 10],
        maxSteps: [15, 25],
    }
},

//////////////////////////////////////////////////////
// Enemies
//////////////////////////////////////////////////////

enemies: [
    {
        majorDifficulty: 0,
        amount: [1, 1],
        allowedEnemies: [ "Outlaw" ],
    },
    {
        majorDifficulty: 2,
        amount: [1, 2],
        allowedEnemies: [ "Outlaw", "Pyro" ],
    },
    {
        majorDifficulty: 3,
        amount: [1, 2],
        allowedEnemies: [ "Outlaw", "Pyro", "Witch" ],
    },
    {
        majorDifficulty: 4,
        amount: [2, 3],
        allowedEnemies: [ "Outlaw", "Pyro", "Witch" ],
    },
],

allowedEnemyConfigurations: [
    [ "Outlaw" ],
    [ "Outlaw", "Outlaw" ],
    [ "Outlaw", "Outlaw", "Outlaw" ],
    [ "Outlaw", "Witch" ],
    [ "Outlaw", "Witch", "Witch" ],
    [ "Outlaw", "Outlaw", "Witch" ],
    [ "Pyro" ],
    [ "Outlaw", "Pyro" ],
    [ "Outlaw", "Outlaw", "Pyro" ],
    [ "Outlaw", "Pyro", "Pyro" ],
    [ "Outlaw", "Pyro", "Witch" ],
],

enemyProbabilityIncrease: [
    {
        enemy: "Outlaw",
        biome: "wasteland",
        bonusPoints: 20,
    },
    {
        enemy: "Outlaw",
        biome: "bewitched_forest",
        bonusPoints: 20,
    },
    {
        enemy: "Outlaw",
        biome: "magenta_mountains",
        bonusPoints: 20,
    },
    {
        enemy: "Pyro",
        biome: "wasteland",
        bonusPoints: 20,
    },
    {
        enemy: "Witch",
        biome: "bewitched_forest",
        bonusPoints: 20,
    },
],

enemyProbabilityRandomPoints: 120,

enemyHealthAdjustment: 0.6,
enemyDamageAdjustment: 0.3,

difficultyScaling: {
    limited: {
        encounterStartedScale: 0.17,
        relativeMin: 0.0,
        relativeMax: 0.5,
        scaling: $PowerScaling {
            power: 3,
        },
    },
    constructed: {
        encounterStartedScale: 0.17,
        relativeMin: 0.3,
        relativeMax: 0.7,
        scaling: $LinearScaling {},
    },
},

//////////////////////////////////////////////////////
// Limited Challenges
//////////////////////////////////////////////////////

limitedChallenges: [
    {
        addAtDifficulty: 0,
        challenges: []
    },
    {
        addAtDifficulty: 2,
        challenges: [
            $PriceIncrease {
                multitplier: 1.25
            }
        ]
    },
    {
        addAtDifficulty: 3,
        challenges: [
            $DifficultyIncrease {
                increase: 1.0
            }
        ]
    },
    {
        addAtDifficulty: 4,
        challenges: [
            $ReduceStepAmount {
                reduceBy: 3
            }
        ]
    },
]
