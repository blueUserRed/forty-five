///schema=onjschemas/dialogs.onjschema
import "imports/colors.onj" as color;

var shake = $ShakeTextAction {
    xSpeed: 0.2,
    xMagnitude: 1.0,
    ySpeed: 0.1,
    yMagnitude: 1.0,
};

dialogs: [
    {
        name: "tutorial_dialog",
        eventText: "",
        parts: [
            {
                rawText: "Hello, I've heard you want to try your luck in the frontier?",
                rightNpc: "npc.brother",
                leftNpc: null,
                talkingNpc: "npc.brother",
                next: $Continue {},
            },
            {
                rawText: "But before I let you go, you will have to complete a small trial run I prepared for you, to make sure you know how to use a revolver",
                rightNpc: "npc.brother",
                leftNpc: null,
                talkingNpc: "npc.brother",
                next: $Continue {},
            },
            {
                rawText: "Ready? Go!",
                rightNpc: "npc.brother",
                leftNpc: null,
                talkingNpc: "npc.brother",
                next: $StartSpecialRunEnd { run: "tutorial_run" },
            }
        ],
        defaults: {
            font: "red wing",
            fontSize: 32,
            color: color.forty_white
        }
    },
    {
        name: "aqua_balle_progress_dialog",
        eventText: "",
        parts: [
            {
                rawText: "Hello.",
                rightNpc: "npc.brother",
                leftNpc: null,
                talkingNpc: "npc.brother",
                next: $MatchPredicate {
                    options: [
                        {
                            predicate: $RunCompleted { runName: "aqua_balle_progress_run" },
                            label: "runCompleted"
                        },
                        {
                            predicate: $RunInCurrentBoard { runName: "aqua_balle_progress_run" },
                            label: "runGiven"
                        },
                        {
                            predicate: $MinimumRunsWon { minimum: 3 },
                            label: "giveRun"
                        }
                    ],
                    default: "dontGiveRun"
                }
            },
            {
                label: "runGiven",
                rawText: "When you feel ready, you start the mission by clicking on 'Run Board' and selecting progress run",
                rightNpc: "npc.brother",
                leftNpc: null,
                talkingNpc: "npc.brother",
                next: $EndOfDialog {},
            },
            {
                label: "runCompleted",
                rawText: "You showed these Outlaws! Good work!",
                rightNpc: "npc.brother",
                leftNpc: null,
                talkingNpc: "npc.brother",
                next: $EndOfDialog {},
            },
            {
                label: "giveRun",
                rawText: "I have a mission for you. The road to tabu letter outpost is full of all kinds of outlaws and needs to be cleared.",
                rightNpc: "npc.brother",
                leftNpc: null,
                talkingNpc: "npc.brother",
                next: $Continue {},
            },
            {
                rawText: "But you need to be careful: I heard reports of some outlaw with a gas mask, and where he was, fire always followed.",
                rightNpc: "npc.brother",
                leftNpc: null,
                talkingNpc: "npc.brother",
                next: $Continue {},
            },
            {
                rawText: "I'll add the mission to your Run Board. When the road is cleared we will finally be able to go to tabu letter outpost again",
                rightNpc: "npc.brother",
                leftNpc: null,
                talkingNpc: "npc.brother",
                next: $AddSpecialRunEnd { run: "aqua_balle_progress_run" },
            },
            {
                label: "dontGiveRun",
                rawText: "I'm looking for someone to help me on an important mission. It looks like you're still quite inexperienced though",
                rightNpc: "npc.brother",
                leftNpc: null,
                talkingNpc: "npc.brother",
                next: $Continue {},
            },
            {
                label: "dontGiveRun",
                rawText: "Complete a few runs from you run board first, and when you feel ready, you can come back",
                rightNpc: "npc.brother",
                leftNpc: null,
                talkingNpc: "npc.brother",
                next: $EndOfDialog {},
            },
        ],
        defaults: {
            font: "red wing",
            fontSize: 32,
            color: color.forty_white
        }
    },
    {
        name: "testing_dialog",
        eventText: "hi",
        parts: [
            {
                rawText: "Hello, this is just an example text because i am awesome... Hello, this is just an example text because i am awesome...Hello, this is just an example text because i am awesome...",
                rightNpc: "npc.priest_of_aqua_balle",
                leftNpc: null,
                talkingNpc: "npc.priest_of_aqua_balle",
                next: $Continue {
                },
            },
            {
                rawText: "Hello, this is just an example text because i am awesome... Hello, this is just an example text because i am awesome...Hello, this is just an example text because i am awesome...",
                rightNpc: "npc.priest_of_aqua_balle",
                leftNpc: "npc.brother",
                talkingNpc: "npc.brother",
                next: $Continue {
                },
            },
            {
                rawText: "Hello, this is just an example text because i am awesome... Hello, this is just an example text because i am awesome...Hello, this is just an example text because i am awesome...",
                rightNpc: "npc.priest_of_aqua_balle",
                leftNpc: null,
                talkingNpc: "npc.priest_of_aqua_balle",
                next: $Continue {
                },
            },
            {
                rawText: "Bye",
                rightNpc: "npc.priest_of_aqua_balle",
                leftNpc: "npc.brother",
                talkingNpc: "npc.brother",
                next: $EndOfDialog { }
            },
        ],
        defaults: {
            font: "red wing",
            fontSize: 32,
            color: color.forty_white
        }
    },
    {
        name: "talk_with_brother",
        eventText: "Talk to your brother",
        parts: [
            {
                rawText: "Hi.",
                talkingNpc: "npc.brother",
                rightNpc: "npc.brother",
                leftNpc: null,
                next: $Continue {}
            },
            {
                rawText: "Glad I caught you before you left",
                talkingNpc: "npc.brother",
                rightNpc: "npc.brother",
                leftNpc: null,
                next: $Continue {
                }
            },
            {
                rawText: "I know I can't stop you from taking on this voyage, but please promise to be careful",
                talkingNpc: "npc.brother",
                rightNpc: "npc.brother",
                leftNpc: null,
                next: $Continue {
                }
            },
            {
                rawText: "Also, there is $1something$1 I wanted to give you before you leave",
                talkingNpc: "npc.brother",
                rightNpc: "npc.brother",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.blue
                    },
                ],
                next: $Continue {
                }
            },
            {
                rawText: "Here, this might be useful on your journey",
                talkingNpc: "npc.brother",
                rightNpc: "npc.brother",
                leftNpc: null,
                next: $GiftCardEnd {
                    card: {
                        name: "incendiaryBullet"
                    }
                }
            },
        ],
        defaults: {
            font: "red wing",
            fontSize: 32,
            color: color.forty_white
        }
    },
    {
        name: "tavelling_merchant_welcome",
        eventText: "A strangers greeting",
        parts: [
            {
                rawText: "Howdy, welcome in $1Aqua Balle$1, where all the scum, outlaws and gamblers of the $1Old World$1 come together to find their luck in the frontier.",
                talkingNpc: "npc.traveling_merchant",
                rightNpc: "npc.traveling_merchant",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.orange
                    },
                ],
                next: $Continue {
                }
            },
            {
                rawText: "You can buy some $3cursed$3 Bullets at my shop over there, coffins can be preordered.",
                talkingNpc: "npc.traveling_merchant",
                rightNpc: "npc.traveling_merchant",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.red
                    },
                    $Action {
                        indicator: "$3",
                        action: shake,
                    },
                ],
                next: $ChooseNextPart {
                    choices: [
                        {
                            name: "The frontier?",
                            next: "frontier"
                        },
                        {
                            name: "Bullets?",
                            next: "bullets"
                        },
                        {
                            name: "Goodbye",
                            next: "end"
                        }
                    ]
                }
            },
            {
                label: "frontier",
                rawText: "Yes, the land that was discovered here a while ago. This town serves as the entrance to it. How did you not know this? ",
                talkingNpc: "npc.traveling_merchant",
                rightNpc: "npc.traveling_merchant",
                leftNpc: null,
                next: $Continue {
                }
            },
            {
                rawText: "It's a lawless zone out there, although since the governor showed up here, it hasn't been the same anymore...",
                talkingNpc: "npc.traveling_merchant",
                rightNpc: "npc.traveling_merchant",
                leftNpc: null,
                next: $ChooseNextPart {
                    choices: [
                        {
                            name: "Bullets?",
                            next: "bullets"
                        },
                        {
                            name: "Goodbye",
                            next: "end"
                        }
                    ]
                }
            },
            {
                label: "bullets",
                rawText: "... yeah, I don't know why they are here or what they are, but they can be found all over the frontier.",
                talkingNpc: "npc.traveling_merchant",
                rightNpc: "npc.traveling_merchant",
                leftNpc: null,
                next: $Continue {
                }
            },
            {
                rawText: "They are really powerful and also $3cursed$3, so a lot of people want them either for themselves or to turn a profit.",
                talkingNpc: "npc.traveling_merchant",
                rightNpc: "npc.traveling_merchant",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.red
                    },
                    $Action {
                        indicator: "$3",
                        action: shake,
                    },
                ],
                next: $Continue {
                }
            },
            {
                rawText: "That's where all those guys here come from. They hope to turn their life around and try their luck in the frontier. Good business for us here in $1Aqua Balle$1 though, so I won't complain.",
                talkingNpc: "npc.traveling_merchant",
                rightNpc: "npc.traveling_merchant",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.orange
                    },
                    $Action {
                        indicator: "$3",
                        action: shake,
                    },
                ],
                next: $ChooseNextPart {
                    choices: [
                        {
                            name: "The frontier?",
                            next: "frontier"
                        },
                        {
                            name: "Goodbye",
                            next: "end"
                        }
                    ]
                }
            },
            {
                label: "end",
                rawText: "You can come visit me at my shop over there, if you want.",
                talkingNpc: "npc.traveling_merchant",
                rightNpc: "npc.traveling_merchant",
                leftNpc: null,
                next: $Continue {
                }
            },
            {
                rawText: "But I travel the frontier with my stock most of the time, so we’ll probably see each other anyway. Until then, take care.",
                talkingNpc: "npc.traveling_merchant",
                rightNpc: "npc.traveling_merchant",
                leftNpc: null,
                next: $EndOfDialog { }
            },
        ],
        defaults: {
            font: "red wing",
            fontSize: 32,
            color: color.forty_white
        }
    },
    {
        name: "priest_of_aqua_balle_warning",
        eventText: "The priests warning",
        parts: [
            {
                rawText: "Bless you!",
                talkingNpc: "npc.priest_of_aqua_balle",
                rightNpc: "npc.priest_of_aqua_balle",
                leftNpc: null,
                next: $Continue {
                }
            },
            {
                rawText: "It’s $1$3dangerous$3$1 out there, you should turn back. However, you probably won’t listen to me, nobody does.",
                talkingNpc: "npc.priest_of_aqua_balle",
                rightNpc: "npc.priest_of_aqua_balle",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.red
                    },
                    $Action {
                        indicator: "$3",
                        action: shake,
                    },
                ],
                next: $Continue {
                }
            },
            {
                rawText: "So, here take $1this$1 at least. It will look over you on the way.",
                talkingNpc: "npc.priest_of_aqua_balle",
                rightNpc: "npc.priest_of_aqua_balle",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.blue
                    },
                    $Action {
                        indicator: "$3",
                        action: shake,
                    },
                ],
                next: $GiftCardEnd {
                    card: { name: "guardianAngelBullet" },
                }
            },
        ],
        defaults: {
            font: "red wing",
            fontSize: 32,
            color: color.forty_white
        }
    },
    {
        name: "not_yet_implemented_dialog",
        eventText: "Construction Site",
        parts: [
            {
                rawText: "Hello!",
                talkingNpc: "npc.not_yet_implemented",
                rightNpc: "npc.not_yet_implemented",
                leftNpc: null,
                next: $Continue {
                }
            },
            {
                rawText: "This area is still under construction, so maybe check back later.",
                talkingNpc: "npc.not_yet_implemented",
                rightNpc: "npc.not_yet_implemented",
                leftNpc: null,
                next: $Continue {
                }
            },
            {
                rawText: "Thanks for you patience!",
                talkingNpc: "npc.not_yet_implemented",
                rightNpc: "npc.not_yet_implemented",
                leftNpc: null,
                next: $EndOfDialog {}
            },
        ],
        defaults: {
            font: "red wing",
            fontSize: 32,
            color: color.forty_white
        }
    },
    {
        name: "witch_dialog",
        eventText: "Talk with the witch",
        parts: [
            {
                rawText: "$4$1I'll warn you!$1$4",
                talkingNpc: "npc.witch",
                rightNpc: "npc.witch",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.red
                    },
                    $FontSize {
                        indicator: "$4",
                        fontSize: 128,
                    }
                ],
                next: $Continue {
                }
            },
            {
                rawText: "Not a $1single$1 step further or I $4swear to the $3Gods$3 I'll $1kill$1 you$4",
                talkingNpc: "npc.witch",
                rightNpc: "npc.witch",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.red
                    },
                    $Action {
                        indicator: "$3",
                        action: shake,
                    },
                    $FontSize {
                        indicator: "$4",
                        fontSize: (32 * 1.4)#int
                    }
                ],
                next: $Continue {
                }
            },
            {
                rawText: "This was $1$3$4OUR$4$3$1 home before you all came and took it.",
                talkingNpc: "npc.witch",
                rightNpc: "npc.witch",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.red
                    },
                    $Action {
                        indicator: "$3",
                        action: shake,
                    },
                    $FontSize {
                        indicator: "$4",
                        fontSize: (1.4 * 32)#int
                    }
                ],
                next: $Continue {
                }
            },
            {
                rawText: "Someday, the $2Onathans$2 will return to $5Salem$5 and reclaim it. Until then, $1$4stay away$4$1 from it if you value your $3life$3.",
                talkingNpc: "npc.witch",
                rightNpc: "npc.witch",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.red
                    },
                    $Color {
                        indicator: "$2",
                        color: color.grey
                    },
                    $Color {
                        indicator: "$5",
                        color: color.orange
                    },
                    $Action {
                        indicator: "$3",
                        action: shake,
                    },
                    $FontSize {
                        indicator: "$4",
                        fontSize: (1.4 * 32)#int
                    }
                ],
                next: $Continue {
                }
            },
            {
                rawText: "Oh and and tell the $2governor$2 that his days are $1$3limited$3$1.",
                talkingNpc: "npc.witch",
                rightNpc: "npc.witch",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.red
                    },
                    $Color {
                        indicator: "$2",
                        color: color.grey
                    },
                    $Color {
                        indicator: "$5",
                        color: color.orange
                    },
                    $Action {
                        indicator: "$3",
                        action: shake,
                    },
                    $FontSize {
                        indicator: "$4",
                        fontSize: (1.4 * 32)#int
                    }
                ],
                next: $EndOfDialog { }
            },
        ],
        defaults: {
            font: "red wing",
            fontSize: (1.2 * 32)#int,
            color: color.forty_white
        }
    },
    {
        name: "traveler_in_salem_dialog",
        eventText: "Talk with the Traveller",
        parts: [
            {
                rawText: "Mornin'. Good seein' someone who doesn't want to kill me at first sight.",
                talkingNpc: "npc.traveler_in_salem",
                rightNpc: "npc.traveler_in_salem",
                leftNpc: null,
                next: $Continue {}
            },
            {
                rawText: "I traveled around here a lot, so if there is any question you wanna ask feel free. I study the culture and history of the $1Onathahans$1, so i might know a few things...",
                talkingNpc: "npc.traveler_in_salem",
                rightNpc: "npc.traveler_in_salem",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.magenta
                    },
                ],
                next: $ChooseNextPart {
                    choices: [
                        {
                            name: "Onathahans?",
                            next: "onathahans"
                        },
                        {
                            name: "What's beyond the forest?",
                            next: "forest"
                        },
                        {
                            name: "Who are you?",
                            next: "you"
                        },
                        {
                            name: "Goodbye",
                            next: "end"
                        },
                    ]
                }
            },
            {
                label: "onathahans",
                rawText: "Yes, the tribe of people who inhabited this land before we came here from the Old World. People often call them $1witches$1. But they are people, like you and me, no different.",
                talkingNpc: "npc.traveler_in_salem",
                rightNpc: "npc.traveler_in_salem",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.magenta
                    },
                ],
                next: $Continue {}
            },
            {
                rawText: "$1$4If you even are a person. Who knows? I might have been conversing with a tree $5§§map_decoration_bewitched_forest_tree1§§$5$4 this whole time...$4$1",
                talkingNpc: "npc.traveler_in_salem",
                rightNpc: "npc.traveler_in_salem",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.grey
                    },
                    $FontSize {
                        indicator: "$4",
                        fontSize: (0.6 * 32)#int
                    },
                    $FontSize {
                        indicator: "$5",
                        fontSize: (1.1 * 32)#int
                    }
                ],
                next: $ChooseNextPart {
                    choices: [
                        {
                            name: "What's beyond the forest?",
                            next: "forest"
                        },
                        {
                            name: "Who are you?",
                            next: "you"
                        },
                        {
                            name: "Goodbye",
                            next: "end"
                        },
                    ]
                }
            },
            {
                label: "forest",
                rawText: "Hm? oh yes, beyond the forest... I've read stories from the Onathahans. There is said to be a sacred place beyond the forest...",
                talkingNpc: "npc.traveler_in_salem",
                rightNpc: "npc.traveler_in_salem",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.magenta
                    },
                ],
                next: $Continue {}
            },
            {
                rawText: "How did they call it? Was it ... oh yes, $1$4The Magenta Mountains$4$1. Soon, we will be able to see what the stories are about...",
                talkingNpc: "npc.traveler_in_salem",
                rightNpc: "npc.traveler_in_salem",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.magenta
                    },
                    $FontSize {
                        indicator: "$4",
                        fontSize: (1.2 * 32)#int
                    }
                ],
                next: $ChooseNextPart {
                    choices: [
                        {
                            name: "Onathahans?",
                            next: "onathahans"
                        },
                        {
                            name: "Who are you?",
                            next: "you"
                        },
                        {
                            name: "Goodbye",
                            next: "end"
                        },
                    ]
                }
            },
            {
                label: "you",
                rawText: "Me? I'm just a traveler. I travel... learn as much as I can as long as I have time... I think the frontier is fascinating... so many stories and places to discover... ",
                talkingNpc: "npc.traveler_in_salem",
                rightNpc: "npc.traveler_in_salem",
                leftNpc: null,
                effects: [
                    $Color {
                        indicator: "$1",
                        color: color.magenta
                    },
                ],
                next: $ChooseNextPart {
                    choices: [
                        {
                            name: "Onathahans?",
                            next: "onathahans"
                        },
                        {
                            name: "What's beyond the forest?",
                            next: "forest"
                        },
                        {
                            name: "Goodbye",
                            next: "end"
                        },
                    ]
                }
            },
            {
                label: "end",
                rawText: "Bye",
                talkingNpc: "npc.traveler_in_salem",
                rightNpc: "npc.traveler_in_salem",
                leftNpc: null,
                next: $EndOfDialog { }
            },
        ],
        defaults: {
            font: "red wing",
            fontSize: 32,
            color: color.forty_white
        }
    },
],

