import "imports/colors.onj" as color;
use Common;


hoverDetailDescriptions: [
    {
        keyword: "BURNING",
        groupName: "status",
        description: "$status$BURNING (r)$status$\nBurning increases damage not caused by status effects by 50% for r revolver rotations.",
    },
    {
        keyword: "POISON",
        groupName: "status",
        description: "$status$POISON (d)$status$\nOn-Turn-End: deal d dmg, then, remove 50% of d",
    },
    {
        keyword: "SHIELD",
        groupName: "status",
        description: "$status$SHIELD (d)$status$\nShield protects from d dmg.",
    },
    {
        keyword: "BEWITCHED",
        groupName: "status",
        description: "$status$BEWITCHED (t, r)$status$\nAll bullets turn the revolver one to the left. Active for t turns or r rotations.",
    },
    {
        keyword: "FROZEN",
        groupName: "status",
        description: "$status$FROZEN (x)$status$\nThe Revolver won't rotate for x shots.",
    },
    {
        keyword: "PROTECTED",
        groupName: "trait", // TODO: should be keyword
        description: "$trait$PROTECTED (x)$trait$\nA bullet with protected won't leave the revolver On-Shot for x times. Doesn't work on undead bullets.",
    },
    {
        keyword: "DISINTEGRATION",
        groupName: "trait",
        description: "$trait$DISINTEGRATION$trait$\nA bullet with disintegration loses 1 dmg On-Rotate. When a bullet with disintegration has 0 dmg, destroy it.",
    },
    {
        keyword: "SPRAY",
        groupName: "trait",
        description: "$trait$SPRAY$trait$\nA bullet with spray hits all enemies ",
    },
    {
        keyword: "EVERLASTING",
        groupName: "trait",
        description: "$trait$EVERLASTING$trait$\nA bullet with everlasting won't leave the revolver On-Shot",
    },
    {
        keyword: "UNDEAD",
        groupName: "trait",
        description: "$trait$UNDEAD$trait$\nA bullet with undead is returned to your hand On-Leave.",
    },
    {
        keyword: "REINFORCED",
        groupName: "trait",
        description: "$trait$REINFORCED$trait$\nWhen parrying with a bullet that is reinforced, no dmg will come through, even if this bullets dmg value is smaller than the attack that is being parried.",
    },
    {
        keyword: "JAMMED",
        groupName: "trait",
        description: "$trait$JAMMED$trait$\nWhen shooting or parrying with this bullet, the revolver doesn’t rotate",
    },
    {
        keyword: "THORNS",
        groupName: "trait",
        description: "$trait$THORNS$trait$\nWhen parrying with this bullet, the enemy takes x dmg, where x is the dmg value of the attack which was parried.",
    },
    {
        keyword: "HARDENED", // TODO: Should be keyword
        groupName: "trait",
        description: "$trait$HARDENED (x)$trait$\nFor the next x times this bullet is used to parry, it won't leave the revolver ",
    },
    {
        keyword: "DISCHARGE POISON",
        groupName: "keyword",
        description: "$keyword$DISCHARGE POISON (x)$keyword$\nIf the enemy has $status$POISON$status$, resolve x turns worth of poison dmg all at once.",
    },
    {
        keyword: "SEARCH",
        groupName: "keyword",
        description: "$keyword$SEARCH$keyword$\nPuts a random card from the deck into the players hand, that matches the requirement.",
    },
    {
        keyword: "CREATE",
        groupName: "keyword",
        description: "$keyword$CREATE$keyword$\ncreated cards get removed after the encounter",
    },
    {
        keyword: "CLEANSE",
        groupName: "keyword",
        description: "$keyword$CLEANSE$keyword$\nRemoves all status effects the player has",
    },
    {
        keyword: "DEFENSE",
        groupName: "keyword",
        description: "$keyword$DEFENSE (p)$keyword$\nWhen a bullet with DEFENSE is parried with, it uses p to parry instead of its dmg",
    },
    {
        keyword: "UNOBTAINABLE",
        groupName: "keyword",
        description: "$keyword$UNOBTAINABLE$keyword$\nCan only be added to the deck through Bullet effects, remove from the deck after the encounter",
    },
],

hoverDetailDescriptionGroups: [
    {
        name: "status",
        color: color.orange,
    },
    {
        name: "trait",
        color: color.seljuk_blue,
    },
    {
        name: "keyword",
        color: color.orange,
    }
],

defaultTextEffects: [
    $Color {
        indicator:"$trigger$",
        color: color.hemoglobin_red,
    },

    $FontSize {
        indicator:"$trigger$",
        fontSize: (24 * 0.8)#int,
    },

    $Color {
        indicator:"$dmgBuff$",
        color: color.green,
    },

    $Color {
        indicator:"$dmgNerf$",
        color: color.red,
    },

    $Color {
        indicator:"$costIncrease$",
        color: color.red,
    },

    $Color {
        indicator:"$costDecrease$",
        color: color.green,
    },
]