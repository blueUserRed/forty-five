import "imports/colors.onj" as color;
use Common;


hoverDetailDescriptions: [
    {
        keyword: "BURNING",
        groupName: "status",
        description: "$status$BURNING (r)$status$\nBurning increases damage not caused by status effects by 50% for r revolver rotations.",
    },
    {
        keyword: "POISON",
        groupName: "status",
        description: "$status$POISON (d)$status$\nOn-Turn-End: deal d dmg, then, remove 50% of d",
    },
    {
        keyword: "SHIELD",
        groupName: "status",
        description: "$status$SHIELD (d)$status$\nShield protects from d dmg. d halves On-Turn-Begin",
    },
    {
        keyword: "BEWITCHED",
        groupName: "status",
        description: "$status$BEWITCHED (t, r)$status$\nAll bullets turn the revolver one to the left. Active for t turns or r rotations.",
    },
    {
        keyword: "FROZEN",
        groupName: "status",
        description: "$status$FROZEN (x)$status$\nThe Revolver won't rotate for x shots. Everlasting doesn't work.",
    },
    {
        keyword: "BOUNTY",
        groupName: "status",
        description: "$status$BOUNTY (t, r)$status$\nFor t turns, when an enemy with the BOUNTY statuseffect dies: the player gets r reserves. This statuseffect doesn't stack.",
    },
    {
        keyword: "WEAK",
        groupName: "status",
        description: "$status$WEAK (t)$status$\ndmg of attacks are halfed rounded down for t turns",
    },
    {
        keyword: "PROTECTED",
        groupName: "trait", // TODO: should be keyword
        description: "$trait$PROTECTED (x)$trait$\nA bullet with protected won't leave the revolver On-Shot for x times. Doesn't work on undead bullets.",
    },
    {
        keyword: "DISINTEGRATION",
        groupName: "trait",
        description: "$trait$DISINTEGRATION$trait$\nA bullet with disintegration loses 1 dmg On-Rotate. When a bullet with disintegration has 0 dmg, destroy it.",
    },
    {
        keyword: "SPRAY",
        groupName: "trait",
        description: "$trait$SPRAY$trait$\nA bullet with spray hits all enemies ",
    },
    {
        keyword: "EVERLASTING",
        groupName: "trait",
        description: "$trait$EVERLASTING$trait$\nA bullet with everlasting won't leave the revolver On-Shot",
    },
    {
        keyword: "UNDEAD",
        groupName: "trait",
        description: "$trait$UNDEAD$trait$\nA bullet with undead is returned to your hand On-Leave.",
    },
    {
        keyword: "REINFORCED",
        groupName: "trait",
        description: "$trait$REINFORCED$trait$\nWhen parrying with a bullet that is reinforced, no dmg will come through, even if this bullets dmg value is smaller than the attack that is being parried.",
    },
    {
        keyword: "JAMMED",
        groupName: "trait",
        description: "$trait$JAMMED$trait$\nWhen shooting or parrying with this bullet, the revolver doesn’t rotate",
    },
    {
        keyword: "THORNS",
        groupName: "trait",
        description: "$trait$THORNS$trait$\nWhen parrying with this bullet, the enemy takes x dmg, where x is the dmg value of the attack which was parried.",
    },
    {
        keyword: "PERSISTENCE",
        groupName: "trait",
        description: "$trait$PERSISTENCE$trait$\nThis Bullet doesn't lose its buffs or debuffs when shot.",
    },
    {
        keyword: "POISON TIP",
        groupName: "trait",
        description: "$trait$POISON TIP$trait$\nA bullet with Poison Tip doesn't deal dmg when it is shot. Instead, the enemy gets $status$POISON$status$ (x), where x is this Bullets dmg value. ",
    },
    {
        keyword: "HIGH VELOCITY",
        groupName: "trait",
        description: "$trait$HIGH VELOCITY$trait$\nThis bullet deals dmg when leaving the revolver instead of only when being shot. ",
    },
    {
        keyword: "PHANTOM",
        groupName: "trait",
        description: "$trait$PHANTOM$trait$\nThis Bullet deals dmg when entering the hand in any way other than drawing cards from the top of your drawpile, instead of when being shot. ",
    },
    {
        keyword: "SPIRIT",
        groupName: "trait",
        description: "$trait$SPIRIT$trait$\nThis Bullet costs 1 less but doesn’t deal dmg when it is shot (Reserve costs can’t be reduced to less than 1 this way.)(Only spawns on 2+ cost bullets) ",
    },
    {
        keyword: "PIERCING",
        groupName: "trait",
        description: "$trait$PIERCING$trait$\nA bullet with piercing ignores enemy shields and always deals dmg to the hp of the enemy. ",
    },
    {
        keyword: "HARDENED", // TODO: Should be keyword
        groupName: "keyword",
        description: "$keyword$HARDENED (x)$keyword$\nFor the next x times this bullet is used to parry, it won't leave the revolver ",
    },
    {
        keyword: "DISCHARGE POISON",
        groupName: "keyword",
        description: "$keyword$DISCHARGE POISON (x)$keyword$\nIf the enemy has $status$POISON$status$, resolve x turns worth of poison dmg all at once.",
    },
    {
        keyword: "SEARCH",
        groupName: "keyword",
        description: "$keyword$SEARCH$keyword$\nPuts a random card from the deck into the players hand, that matches the requirement.",
    },
    {
        keyword: "DISCARD",
        groupName: "keyword",
        description: "$keyword$DISCARD$keyword$\nPut a bullet from your hand into the afterlife",
    },
    {
        keyword: "CREATE",
        groupName: "keyword",
        description: "$keyword$CREATE$keyword$\ncreated cards get removed after the encounter",
    },
    {
        keyword: "CLEANSE",
        groupName: "keyword",
        description: "$keyword$CLEANSE$keyword$\nRemoves all status effects the player has",
    },
    {
        keyword: "DEFENSE",
        groupName: "keyword",
        description: "$keyword$DEFENSE (p)$keyword$\nWhen a bullet with DEFENSE is parried with, it uses p to parry instead of its dmg",
    },
    {
        keyword: "UNOBTAINABLE",
        groupName: "keyword",
        description: "$keyword$UNOBTAINABLE$keyword$\nCan only be added to the encounter through Bullet effects",
    },
    {
        keyword: "FULL ROTATION",
        groupName: "keyword",
        description: "$keyword$FULL ROTATION$keyword$\nrotates 5 times in the same direction uninterupted",
    },
    {
        keyword: "RESURRECT",
        groupName: "keyword",
        description: "$keyword$RESURRECT$keyword$\nreturn the first bullet in the Afterlife into a target revolver slot",
    },
    {
        keyword: "ZONE",
        groupName: "keyword",
        description: "$keyword$ZONE$keyword$\nZones are the handcards, the drawpile, the revolver and the afterlife",
    },
],

hoverDetailDescriptionGroups: [
    {
        name: "status",
        color: color.green,
    },
    {
        name: "trait",
        color: color.seljuk_blue,
    },
    {
        name: "keyword",
        color: color.orange,
    }
],

defaultTextEffects: [
    $Color {
        indicator:"$trigger$",
        color: color.hemoglobin_red,
    },

    $FontSize {
        indicator:"$trigger$",
        fontSize: 20,
    },

    $Color {
        indicator:"$stamp$",
        color: color.magenta,
    },

    $FontSize {
        indicator:"$stamp$",
        fontSize: 21,
    },

    $FontSize {
        indicator:"$flavourText$",
        fontSize: 16,
    },

    $Color {
        indicator:"$dmgBuff$",
        color: color.green,
    },

    $Color {
        indicator:"$dmgNerf$",
        color: color.red,
    },

    $Color {
        indicator:"$costIncrease$",
        color: color.red,
    },

    $Color {
        indicator:"$costDecrease$",
        color: color.green,
    },
]