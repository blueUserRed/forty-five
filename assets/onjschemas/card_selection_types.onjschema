use Common;

var cardSelectorSharedKeys = {
    negate?: boolean,
};

$CardSelector{

    $ByName {
        name: string,
        ...cardSelectorSharedKeys
    }

    $ByTag{
        name: string,
        ...cardSelectorSharedKeys
    }

    $All {
        ...cardSelectorSharedKeys
    }

}

$CardEffect{
    $Blacklist { }

    $ProbabilityAddition {
        weight: float
    }

    $PriceMultiplier {
        price: float
    }

    $PriceAddition {
        price: int
    }
}
var cardChange = {
    select: $CardSelector,
    effect: $CardEffect
};

types: {
    cardChanges: cardChange[],
    name: string
}[],

biomes: {
    name: string,
    changes: cardChange[],
}[],

difficulties: {
    difficulty : int,
    changes: cardChange[],
}[],

default: cardChange[],
