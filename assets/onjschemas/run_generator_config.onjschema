import "imports/run.onjschema" as _;

runModifierPools: {
    majorDifficulty: int,
    modifierProbability: float,
    modifiers: string[]
}[],

runModifierProbabilityIncreases: {
    biome: string,
    makeMoreLikely: string[]
}[],

runModifierBlacklist: string[][],
encounterModifierBlacklist: string[][],

runModifiersMax: int,


runRewardPools: {
    majorDifficulty: Int,
    maxRewards: Int,
    rewardProbability: float,
    rewards: $RunReward[][]
}[],

encounterModifierPools: {
    majorDifficulty: int,
    modifierProbability: float,
    maxModifiers: int,
    modifiers: string[]
}[],

enemies: {
    majorDifficulty: int,
    amount: int[2],
    allowedEnemies: string[],
}[],

enemyProbabilityIncrease: {
    enemy: string,
    biome: string,
    bonusPoints: int,
}[],

allowedEnemyConfigurations: string[][],

enemyProbabilityRandomPoints: int,

enemyHealthAdjustment: float,
enemyDamageAdjustment: float,

var stepConfig = {
    minSteps: int[2],
    maxSteps: int[2],
};

stepConfig: {
    limited: stepConfig,
    constructed: stepConfig
},

difficultyScaling: {
    limited: {
        encounterStartedScale: float,
        relativeMin: float,
        relativeMax: float,
        scaling: $DifficultyScaling,
    },
    constructed: {
        encounterStartedScale: float,
        relativeMin: float,
        relativeMax: float,
        scaling: $DifficultyScaling,
    },
},

limitedChallenges: {
    addAtDifficulty: int,
    challenges: $RunChallenge[]
}[],
