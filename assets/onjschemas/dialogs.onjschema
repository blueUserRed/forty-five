import "imports/advanced_text_effect.onjschema" as _;
import "imports/map_predicates.onjschema" as _;
import "onjschemas/card_type.onjschema" as cardType;

use Common;

$NextDialogPartSelector {

    $Continue { }

    $FixedNextPart {
        next: string
    }

    $ChooseNextPart {
        choices: {
            name: string,
            next: string
        }[]
    }

    $EndOfDialog { }

    $GiftCardEnd {
        card: cardType
    }

    $ByPredicate {
        predicate: $MapPredicate,
        ifTrue: string,
        ifFalse: string,
    }

    $MatchPredicate {
        options: {
            predicate: $MapPredicate,
            label: string
        }[],
        default: string
    }

    $StartSpecialRunEnd {
        run: string,
    }

    $AddSpecialRunEnd {
        run: string
    }

    $ToCreditScreenEnd { }

}

var dialog = {
    name: string,
    eventText: string,
    parts: {
        rawText: string,
        leftNpc: string?,
        rightNpc: string?,
        talkingNpc: string,
        label?: string,
        effects?: $AdvancedTextEffect[],
        next: $NextDialogPartSelector
    }[],
    defaults: {
        font: string,
        fontSize: int,
        color: Color
    },
};

dialogs: dialog[]
