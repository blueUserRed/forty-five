import "imports/advanced_text_effect.onjschema" as _;

use Common;

$NextDialogPartSelector {

    $Continue { }

    $FixedNextPart {
        next: string
    }

    $ChooseNextPart {
        choices: {
            name: string,
            next: string
        }[]
    }

    $EndOfDialog { }

    $GiftCardEnd {
        card: string
    }

    $ToCreditScreenEnd { }

}

var dialog = {
    name: string,
    eventText: string,
    parts: {
        rawText: string,
        leftNpc: string?,
        rightNpc: string?,
        talkingNpc: string,
        label?: string,
        effects?: $AdvancedTextEffect[],
        next: $NextDialogPartSelector
    }[],
    defaults: {
        font: string,
        fontScale: float,
        color: Color
    },
};

dialogs: dialog[]


var image = {
    textureName: string,
    offsetX?: float,
    offsetY?: float,
    flipOnRightSide?: boolean,
    width: float,
    height: float,
};

npcs: {
    name: string,
    image: image,
}[]
