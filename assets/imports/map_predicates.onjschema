
$MapPredicate {

    $PlayerHasCard {
        card: string
    }

    $RunCompleted {
        runName: string
    }

    $RunInCurrentBoard {
        runName: string
    }

    $MinimumRunsWon {
        minimum: int
    }

    $MinStepsReached {}

    $CurrentNodeCompleted {}

    $CurrentNodeBlocks {}

    $Not {
        negate: $MapPredicate
    }

    $Or {
        predicates: $MapPredicate[]
    }

    $And {
        predicates: $MapPredicate[]
    }

    $Never {}

    $Always {}

}
