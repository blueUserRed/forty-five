
$MapPredicate {

    $PlayerHasCard {
        card: string
    }

    $Not {
        negate: $MapPredicate
    }

    $Never {}

    $ProgressRunCompleted {}

}

var mapEventStandardConfig = {
    currentlyBlocks: boolean,
    startable: boolean,
    isCompleted: boolean,
    startConditions?: $MapPredicate[]
};

var encounter = {
    enemies: string[],
    encounterModifier: string[],
    forceCards: string[]?,
    shuffleCards: boolean,
    minorDifficulty: float,
    special: boolean,
};

$MapEvent {

    $EmptyMapEvent { }

    $EncounterMapEvent {
        ...mapEventStandardConfig,
        encounter: encounter,
        isExtraction: boolean
    }

    $EnterMapMapEvent {
        targetMap: string,
        fromEnd: Boolean,
    }

    $DialogMapEvent {
        dialog: string,
        canOnlyBeStartedOnce: boolean,
        onlyIfPlayerDoesntHaveCard?: string,
        ...mapEventStandardConfig
    }

    $ShopMapEvent {
        types: string[],
        person: string,
        amountCards: int[2],
        currentCards: string[]?,
        amountOfRerolls: int,
        rerollPriceIncrease: int,
        rerollBasePrice: int,
        boughtIndices: int[],
    }

    $ChooseCardMapEvent {
        types: string[],
        seed: int?,
        nbrOfCards: int,
        amountOfRerolls: int,
        rerollPriceIncrease: int,
        rerollBasePrice: int,
        enableRerolls: boolean,
        ...mapEventStandardConfig
    }

    $LockNodeMapEvent {
        conditions: $MapPredicate[],
        locked: boolean,
        lockedDescription: string,
        openDescription: string,
    }

    $ProgressRunMapEvent {
        ...mapEventStandardConfig
    }

}
