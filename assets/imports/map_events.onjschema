import "imports/map_predicates.onjschema" as _;
import "onjschemas/card_type.onjschema" as cardType;

$DifficultyScaling {
    $LinearScaling {}
    $PowerScaling {
        power: int,
    }
}

var mapEventStandardConfig = {
    isCompleted: boolean,
    descriptionText: {
        predicate: $MapPredicate,
        text: string,
    }[],
    startConditions?: $MapPredicate[],
    blockConditions?: $MapPredicate[],
};

var encounter = {
    enemies: string[],
    encounterModifier: string[],
    forceCards: cardType[]?,
    forceConcreteEnemies?: string[],
    shuffleCards: boolean,
    unadjustedMajorDifficulty: int,
    majorDifficulty: int,
    minorDifficulty: float,
    isHard?: boolean,
    difficultyScalingInfo?: float,
    special: boolean,
};

$MapEvent {

    $EmptyMapEvent { }

    $SimpleMapEvent {
        ...mapEventStandardConfig,
        displayDescription?: boolean,
        displayName?: string
    }

    $EncounterMapEvent {
        ...mapEventStandardConfig,
        encounter: encounter,
        isExtraction: boolean
    }

    $EnterMapMapEvent {
        targetMap: string,
        fromEnd: Boolean,
    }

    $DialogMapEvent {
        dialog: string,
        displayName: string,
        ...mapEventStandardConfig
    }

    $ShopMapEvent {
        types: string[],
        person: string,
        amountCards: int[2],
        currentCards: string[]?,
        amountOfRerolls: int,
        rerollPriceIncrease: int,
        rerollBasePrice: int,
        boughtIndices: int[],
    }

    $ChooseCardMapEvent {
        types: string[],
        seed: int?,
        nbrOfCards: int,
        amountOfRerolls: int,
        rerollPriceIncrease: int,
        rerollBasePrice: int,
        enableRerolls: boolean,
        ...mapEventStandardConfig
    }

    $CompleteRunMapEvent {
        runName: string,
        displayName: string,
        ...mapEventStandardConfig
    }

    $FinishTutorialRunMapEvent { }

    $EncounterPlaceholderMapEvent {
        genExtraction: boolean,
        majorDifficulty: int,
        unadjustedMajorDifficulty: int,
        minorDifficulty: float,
        amountEnemies: int[2],
        difficultyScaling: $DifficultyScaling,
        scaleMin: float,
        scaleMax: float,
        biome: string,
        seed: int
    }

}
