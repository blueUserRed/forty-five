import "imports/map_events.onjschema" as _;

use Common;

$DecorationDistribution {

    $Random {}

    $FadeX {
        start: float,
        end: float,
        interpolation: Interpolation,
    }

}

var decoration = {
    distribution: $DecorationDistribution,
    decoration: string,
    baseWidth: float,
    baseHeight: float,
    density: float,
    checkNodeCollisions: boolean,
    checkLineCollisions: boolean,
    checkDecorationCollisions: boolean,
    generateDecorationCollisions: boolean,
    onlyCheckCollisionsAtSpawnPoints: boolean,
    scale: float[2],
    shrinkBoundsWidth?: float,
    shrinkBoundsHeight?: float,
    sortByY: boolean,
    animated: boolean,
};

var fixedEvent = {
    nodeEvent: $MapEvent,
    nodeTexture: string,
    minDistance: int?,
    maxDistance: int?,
    amount: int
};

var fillEvent = {
    nodeEvent: $MapEvent,
    nodeTexture: string,
    minDistance: int?,
    maxDistance: int?,
    weight: int
};

var mapGeneratorSharedKeys = {
    majorDifficulty: int,
    biome: string,
    horizontalExtension: float,
    verticalExtension: float,
    locationSignProtectedAreaWidth: float,
    locationSignProtectedAreaHeight: float,
    nodeProtectedArea: float,
    firstNodeEvent: $MapEvent,
    firstNodeTexture: string,
    lastNodeEvent: $MapEvent,
    lastNodeTexture: string,
    randomStepsToLastNode: int,
    rotation: float,
    fixedEvents: fixedEvent[],
    fillEvents: fillEvent[],
};

$MapGenerator {

    $PointCloud {
        amountNodes: int,
        roadLength: float,
        roadHeight: float,
        exclusionRadius: float,
        decorations: decoration[],
        ...mapGeneratorSharedKeys
    }

    $ThreeLine {
        roadLength: float,
        mainLineNodes: int,
        altLinesPadding: int[2],
        altLinesOffset: float,
        varianceX: float,
        varianceY: float,
        decorations: decoration[],
        ...mapGeneratorSharedKeys
    }

    $Radial {
        decorations: decoration[],
        circles: {
            radius: float,
            numNodes: int,
            angleVariance: float,
        }[],
        ...mapGeneratorSharedKeys
    }

    $StaticMap {
        name: string
    }

}
