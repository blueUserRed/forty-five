use Common;


var advancedTextEffectSharedKeys = {
    indicator: string,
};

$AdvancedTextEffect {

    $Color {
        color: Color,
        ...advancedTextEffectSharedKeys
    }

    $Font {
        font: string,
        ...advancedTextEffectSharedKeys
    }

    $FontSize {
        fontSize: int,
        ...advancedTextEffectSharedKeys
    }

    $Action {
        action: $AdvancedTextPartAction,
        ...advancedTextEffectSharedKeys
    }

}

$AdvancedTextPartAction {

    $ShakeTextAction {
        xMagnitude: float,
        xSpeed: float,
        yMagnitude: float,
        ySpeed: float,
    }
}